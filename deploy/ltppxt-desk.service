[Unit]
Description=LTPPXT paper desk (@MODE@ mode, @BOT@ bot)
After=network-online.target ltppxt-judge.service
Wants=network-online.target ltppxt-judge.service

[Service]
User=ltppxt
EnvironmentFile=/etc/ltppxt/desk.env
WorkingDirectory=@APP@
StateDirectory=ltppxt
ExecStart=@APP@/.venv/bin/python -m desk.run --mode @MODE@ --bot @BOT@ --feed coinbase --log-dir /var/lib/ltppxt/logs
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
